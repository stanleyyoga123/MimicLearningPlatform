# Copy to .env. Keep generated artifacts outside this source checkout.
APP_DATA_DIR=/private/tmp/apprenticeship-data
DOCKER_IMAGE=apprenticeship-verifier:local
CODEX_BINARY=codex
# Leave empty to use the authenticated Codex account's default model.
CODEX_MODEL=
# Read by the worker for publishing only; never sent to Codex.
GITHUB_TOKEN=
# GitHub App for PR reviews; install with Contents: read and Pull requests: write.
GITHUB_APP_ID=
# Absolute PEM path OUTSIDE this project and APP_DATA_DIR; never sent to Codex.
GITHUB_APP_PRIVATE_KEY_PATH=
# Use the same random secret in the App's webhook settings. Keep server-side.
GITHUB_WEBHOOK_SECRET=
# Separate webhook-only listener; forward GitHub webhooks to this port, not API_PORT.
WEBHOOK_PORT=8001
# Used by the API for junior workspace conversations. Keep this on the server.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
CORS_ORIGIN=http://localhost:5173
API_PORT=8000
